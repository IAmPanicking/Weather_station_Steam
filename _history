readRegister(0x8A)\n        let t2MSB = readRegister(0x8B)\n\n        parT2 = signed16(\n            (t2MSB << 8) | t2LSB\n        )\n\n        // par_t3: 0x8C\n        parT3 = signed8(\n            readRegister(0x8C)\n        )\n\n        // par_t1: 0xE9 / 0xEA\n        let t1LSB = readRegister(0xE9)\n        let t1MSB = readRegister(0xEA)\n\n        parT1 =\n            (t1MSB << 8) | t1LSB\n\n        initialized = true\n    }\n\n\n    /**\n     * Nustato BME688 I2C adresą 0x76\n     */\n    //% block=\"set address 0x76\"\n    //% weight=100\n    export function setAddress(): void {\n        address = 0x76\n        initialized = false\n    }\n\n\n    /**\n     * Atlieka vieną BME688 matavimą\n     */\n    //% block=\"measure\"\n    //% weight=90\n    export function measure(): void {\n\n        initialize()\n\n        // Humidity oversampling x1\n        writeRegister(0x72, 0x01)\n\n        // Temperature oversampling x2\n        // Pressure oversampling x1\n        // Forced mode\n        writeRegister(0x74, 0x45)\n\n        basic.pause(100)\n\n        // Temperature ADC:\n        // 0x22 = MSB\n        // 0x23 = LSB\n        // 0x24 = XLSB\n\n        let msb = readRegister(0x22)\n        let lsb = readRegister(0x23)\n        let xlsb = readRegister(0x24)\n\n        let adcTemperature =\n            (msb << 12) |\n            (lsb << 4) |\n            (xlsb >> 4)\n\n\n        // Bosch floating-point temperature compensation\n\n        let var1 =\n            (\n                adcTemperature / 16384.0 -\n                parT1 / 1024.0\n            ) *\n            parT2\n\n        let var2 =\n            (\n                adcTemperature / 131072.0 -\n                parT1 / 8192.0\n            )\n\n        var2 =\n            var2 *\n            var2 *\n            (\n                parT3 * 16.0\n            )\n\n        let tFine =\n            var1 + var2\n\n        temperatureValue =\n            tFine / 5120.0\n    }\n\n\n    /**\n     * Grąžina temperatūrą °C\n     */\n    //% block=\"temperature °C\"\n    //% weight=80\n    export function temperature(): number {\n        return Math.round(\n            temperatureValue * 10\n        ) / 10\n    }\n}"}]},{"timestamp":1791113625508,"editorVersion":"9.0.12","changes":[{"type":"edited","filename":"main.blocks","patch":[{"start1":0,"length1":1487,"diffs":[[1,"<xml xmlns=\"https://developers.google.com/blockly/xml\"><variables></variables><block type=\"pxt-on-start\" x=\"40\" y=\"46\"><statement name=\"HANDLER\"><block type=\"BME688_setAddress\"></block></statement></block><block type=\"device_forever\" x=\"41\" y=\"218\"><statement name=\"HANDLER\"><block type=\"BME688_measure\"><next><block type=\"device_show_number\"><value name=\"number\"><shadow type=\"math_number\"><field name=\"NUM\">0</field></shadow></value></block></next></block></statement></block><block type=\"BME688_temperature\" disabled-reasons=\"pxt_automatic_disabled\" x=\"368\" y=\"286\"></block></xml>"]]}]},{"type":"edited","filename":"main.ts","patch":[{"start1":69,"length1":230,"diffs":[[1,"    basic.showNumber(0)\n"]]}]},{"type":"edited","filename":"custom.ts","patch":[{"start1":101,"length1":28,"diffs":[[1,""]]},{"start1":102,"length1":31,"diffs":[[1,""]]},{"start1":157,"length1":365,"diffs":[[1,""]]},{"start1":186,"length1":70,"diffs":[[1,"    let initialized = false\n"]]},{"start1":216,"length1":86,"diffs":[[1,""]]},{"start1":411,"length1":0,"diffs":[[1,"\n"]]},{"start1":716,"length1":96,"diffs":[[1,""]]},{"start1":858,"length1":0,"diffs":[[1,"\n"]]},{"start1":1007,"length1":97,"diffs":[[1,""]]},{"start1":1180,"length1":37,"diffs":[[1,"        // BME688 temperature calibration parameters\n        // par_t2: 0x8A / 0x8B\n"]]},{"start1":1413,"length1":0,"diffs":[[1,"        // par_t3: 0x8C\n"]]},{"start1":1504,"length1":0,"diffs":[[1,"        // par_t1: 0xE9 / 0xEA\n"]]},{"start1":1664,"length1":1366,"diffs":[[1,""]]},{"start1":1699,"length1":90,"diffs":[[1,"    /**\n     * Nustato BME688 I2C adres